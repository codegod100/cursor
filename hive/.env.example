# Hive orchestrator configuration

# Prime Agent (Queen) — from codegod100/agentic: nix run github:codegod100/agentic#prime-agent
PRIME_AGENT_BIN=prime-agent
PRIME_API_KEY=

# Cursor Agent (Workers) — from nix-ai-tools or Cursor install
CURSOR_AGENT_BIN=cursor-agent
CURSOR_API_KEY=

# Orchestration
HIVE_MAX_PARALLEL_WORKERS=4
HIVE_WORKER_TIMEOUT_SEC=600
HIVE_QUEEN_MODEL=
HIVE_WORKER_MODEL=composer-2.5

# Server
HIVE_HOST=0.0.0.0
HIVE_PORT=8787
HIVE_DATA_DIR=.hive

# Distributed nodes (comma-separated URLs for remote worker pools)
HIVE_REMOTE_NODES=
