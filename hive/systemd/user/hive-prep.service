[Unit]
Description=Hive prep (deps + runtime.env)
Documentation=file://@ROOT@/systemd/README.md
Before=hive.service

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@ROOT@/scripts/prep.sh
RemainAfterExit=yes

[Install]
WantedBy=hive.target
