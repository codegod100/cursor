[Unit]
Description=Hive orchestrator (HTTP :8000)
Documentation=file://@ROOT@/systemd/README.md
Requires=hive-prep.service
After=hive-prep.service network-online.target
PartOf=hive.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/run/system-manager/sw/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
Environment=HIVE_PORT=8000
Environment=HIVE_HOST=0.0.0.0
EnvironmentFile=-%h/.config/hive/runtime.env
EnvironmentFile=-%h/.config/hive/config.env
ExecStart=@UV@ run hive --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=hive.target
