[Unit]
Description=MCP host on mcp.boxd.sh (HTTP :8000)
Documentation=file://@ROOT@/mcp/host/src/index.ts
Requires=radicle-prep.service
After=radicle-prep.service network-online.target
PartOf=radicle.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/mcp/host
Environment=HOME=%h
Environment=PATH=%h/.radicle/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/radicle/runtime.env
ExecStart=@NPM@ run start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=radicle.target
