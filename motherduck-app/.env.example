# MotherDuck access token (create at https://app.motherduck.com → Settings → Access Tokens)
# Option A: put the token in .motherduck-token (gitignored)
# Option B: set MOTHERDUCK_TOKEN here for local dev
# MOTHERDUCK_TOKEN=

# Optional overrides
# MOTHERDUCK_TOKEN_FILE=.motherduck-token
# MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
# MOTHERDUCK_DB=sample_data
# PORT=3000
