# MotherDuck access token (required)
# Create one at https://app.motherduck.com → Settings → Access Tokens
MOTHERDUCK_TOKEN=

# Optional: Postgres endpoint host (default: US East)
# MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
# MOTHERDUCK_HOST=pg.eu-central-1-aws.motherduck.com

# Optional: database name (default: sample_data)
# MOTHERDUCK_DB=sample_data

# Optional: HTTP port (default: 3000)
# PORT=3000
