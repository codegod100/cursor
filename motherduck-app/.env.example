# MotherDuck access token (create at https://app.motherduck.com → Settings → Access Tokens)
# Option A: direct injection (local dev or Cursor Runtime Secret)
# MOTHERDUCK_TOKEN=

# Option B: load MOTHERDUCK_TOKEN from OpenBao at startup (written to .motherduck-token)
# OPENBAO_TOKEN=
# OPENBAO_ADDR=https://your-openbao-host:8200
# Or put the URL in .openbao-addr instead of OPENBAO_ADDR
# OPENBAO_MOUNT=secret

# Option C: token file on disk (default: .motherduck-token)
# MOTHERDUCK_TOKEN_FILE=.motherduck-token

# Optional overrides
# MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
# MOTHERDUCK_HOST=pg.eu-central-1-aws.motherduck.com
# MOTHERDUCK_DB=sample_data
# PORT=3000
